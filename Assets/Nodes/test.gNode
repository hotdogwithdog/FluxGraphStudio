@inputs
RGBA16F inputTex

@uniforms
Float alpha
RGBA16F shapeImage

@outputs
RGBA16F outputImage


@shader
void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);

    if(pixelCoord.x < UB.outputImage_Size.x && pixelCoord.y < UB.outputImage_Size.y)
    {
        vec2 UV = vec2(pixelCoord) / UB.outputImage_Size;

        vec3 color = texture(inputTex, UV).xyz;
        color = mix(color, vec3(1.0, 0.0, 0.0), 0.2);
        imageStore(outputImage, pixelCoord, vec4(color, 1.0));
    }
}
